# Local development only. Copy to poc/maf/.env, NEVER commit local .env.
POC_POSTGRES_PASSWORD=replace-with-local-password
POC_MINIO_ROOT_USER=pocadmin
POC_MINIO_ROOT_PASSWORD=replace-with-local-object-store-password
# A05 live-only configuration:
# OPENAI_API_KEY=...
# MAF_POC_MODEL=...
# OPENAI_BASE_URL=https://enterprise-gateway.example/v1
# G3 real model self-hosted protocol gate: pass via RUNNER PROCESS environment,
# not through tool argv or a committed env file. The Python probe does not load
# this Compose .env file automatically.
# POC_POSTGRES_DSN=postgresql://poc:<local-db-secret>@127.0.0.1:54329/poc_harness
# POC_LITELLM_MODEL=<admitted-model-name>
# POC_LITELLM_BASE_URL=<local-gateway>/v1
# POC_LITELLM_API_KEY=<set-in-runner-environment-only>
